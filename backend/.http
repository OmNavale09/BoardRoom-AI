###########################################################
### Start Meeting (TEXT)
###########################################################

### Start Meeting without File

POST {{baseUrl}}/meetings/start
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "title": "DevForge AI Startup Review",
    "text": "DevForgeAI is an AI-powered developer career and project guidance platform.The platform analyzes a user's resume to identify existing skills, experience, and technical gaps. It compares the user's current skill set with their desired career goals and generates a personalized roadmap to learn missing skills.DevForgeAI can also analyze project ideas and descriptions to create structured development roadmaps, including required technologies, implementation steps, milestones, and recommended learning paths.The goal of DevForgeAI is to help developers understand where they currently stand, identify what skills they need to improve, and provide AI-generated guidance for building projects and advancing their careers.",
    "github": "https://github.com/OmNavale09/DevForgeAI"
}

###

###########################################################
### Start Meeting (GitHub)
###########################################################

POST {{baseUrl}}/meetings/start
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "projectId":"{{projectId}}",
    "title":"GitHub Review",
    "github":"https://github.com/user/repository"
}

###

###########################################################
### Start Meeting (PDF)
### multipart/form-data
###########################################################

POST {{baseUrl}}/meetings/start
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="projectId"

{{projectId}}

--boundary
Content-Disposition: form-data; name="title"

Pitch Deck

--boundary
Content-Disposition: form-data; name="file"; filename="pitch.pdf"
Content-Type: application/pdf

< ./pitch.pdf

--boundary--

###

###########################################################
### Start Meeting (PPT)
###########################################################

POST {{baseUrl}}/meetings/start
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="projectId"

{{projectId}}

--boundary
Content-Disposition: form-data; name="title"

Startup PPT

--boundary
Content-Disposition: form-data; name="file"; filename="startup.pptx"
Content-Type: application/vnd.openxmlformats-officedocument.presentationml.presentation

< ./startup.pptx

--boundary--

###

###########################################################
### Pause
###########################################################

POST {{baseUrl}}/meetings/{{meetingId}}/action
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "action":"pause"
}

###

###########################################################
### Resume
###########################################################

POST {{baseUrl}}/meetings/{{meetingId}}/action
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "action":"resume"
}

###

